@{
    ViewData["Title"] = "Dashboard - Sistema EY";
}
<link rel="stylesheet" href="~/css/dashboardIndex.css" asp-append-version="true" />
<script src="~/js/indexDashboard.js" asp-append-version="true"></script>

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="mb-1">
                        <i class="bi bi-speedometer2" style="color: #FFE600;"></i>
                        Dashboard
                    </h1>
                    <p class="text-muted">Panel de control y estadísticas del sistema</p>
                </div>
                <div>
                    <span class="badge bg-light text-dark p-3">
                        <i class="bi bi-calendar3"></i> <span id="fechaActual"></span>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Spinner de carga -->
    <div id="loader" class="text-center my-5">
        <div class="spinner-border text-warning" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-muted">Cargando estadísticas...</p>
    </div>

    <!-- Contenido del Dashboard (oculto inicialmente) -->
    <div id="dashboardContent" style="display: none;">
        <!-- Cards de Estadísticas -->
        <div class="row g-4 mb-4">
            <!-- Total Usuarios -->
            <div class="col-xl-3 col-md-6">
                <div class="stats-card card-total">
                    <div class="card-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="card-info">
                        <h3 id="totalUsuarios">0</h3>
                        <p>Total Usuarios</p>
                    </div>
                    <div class="card-badge">
                        <i class="bi bi-graph-up"></i>
                    </div>
                </div>
            </div>

            <!-- Usuarios Activos -->
            <div class="col-xl-3 col-md-6">
                <div class="stats-card card-activos">
                    <div class="card-icon">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div class="card-info">
                        <h3 id="usuariosActivos">0</h3>
                        <p>Usuarios Activos</p>
                    </div>
                    <div class="card-badge">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>

            <!-- Usuarios Inactivos -->
            <div class="col-xl-3 col-md-6">
                <div class="stats-card card-inactivos">
                    <div class="card-icon">
                        <i class="bi bi-person-x-fill"></i>
                    </div>
                    <div class="card-info">
                        <h3 id="usuariosInactivos">0</h3>
                        <p>Usuarios Inactivos</p>
                    </div>
                    <div class="card-badge">
                        <i class="bi bi-x-circle-fill"></i>
                    </div>
                </div>
            </div>

            <!-- Registros Hoy -->
            <div class="col-xl-3 col-md-6">
                <div class="stats-card card-hoy">
                    <div class="card-icon">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <div class="card-info">
                        <h3 id="registrosHoy">0</h3>
                        <p>Registros Hoy</p>
                    </div>
                    <div class="card-badge">
                        <i class="bi bi-clock-fill"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>



@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
   <script>
    let chartRegistros;
    let chartEstatus;

    $(document).ready(function() {
        mostrarFechaActual();
    cargarDashboard();
        });

    function mostrarFechaActual() {
            const fecha = new Date();
    const opciones = {weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
    const fechaFormateada = fecha.toLocaleDateString('es-MX', opciones);
    $('#fechaActual').text(fechaFormateada.charAt(0).toUpperCase() + fechaFormateada.slice(1));
        }

    function cargarDashboard() {
            debugger;
    $.ajax({
        url: '@Url.Action("GetDashboardData", "Dashboard")',
    type: 'GET',
    success: function(response) {
        console.log('Respuesta del servidor:', response);

    if (response.success) {
                        const data = response.data;

    // Ocultar loader y mostrar contenido
    $('#loader').hide();
    $('#dashboardContent').fadeIn();

    // Actualizar cards con animación
    animarNumero('#totalUsuarios', data.totalUsuarios);
    animarNumero('#usuariosActivos', data.usuariosActivos);
    animarNumero('#usuariosInactivos', data.usuariosInactivos);
    animarNumero('#registrosHoy', data.usuariosRegistradosHoy);
    animarNumero('#registrosSemana', data.usuariosRegistradosSemana);
    animarNumero('#registrosMes', data.usuariosRegistradosMes);

    // Crear gráficas
    crearGraficaRegistros(data.registrosPorDia);
    crearGraficaEstatus(data.usuariosActivos, data.usuariosInactivos);
                    } else {
        $('#loader').html('<div class="alert alert-danger">Error: ' + response.message + '</div>');
                    }
                },
    error: function(xhr) {
        console.error('Error al cargar dashboard:', xhr);
    $('#loader').html('<div class="alert alert-danger">Error al cargar las estadísticas. Por favor, intente nuevamente.</div>');
                }
            });
        }

    function animarNumero(selector, valorFinal) {
            const elemento = $(selector);
    const duracion = 1000;
    const pasos = 30;
    const incremento = valorFinal / pasos;
    let valorActual = 0;

    const intervalo = setInterval(function() {
        valorActual += incremento;
                if (valorActual >= valorFinal) {
        elemento.text(valorFinal);
    clearInterval(intervalo);
                } else {
        elemento.text(Math.floor(valorActual));
                }
            }, duracion / pasos);
        }

    function crearGraficaRegistros(registros) {
            const ctx = document.getElementById('chartRegistros');
    if (!ctx) return;

    // Destruir gráfica anterior si existe
    if (chartRegistros) {
        chartRegistros.destroy();
            }

    // Obtener últimos 7 días de registros
    const ultimos7 = registros.slice(-7);
            const fechas = ultimos7.map(r => r.fecha);
            const cantidades = ultimos7.map(r => r.cantidad);

    chartRegistros = new Chart(ctx, {
        type: 'line',
    data: {
        labels: fechas,
    datasets: [{
        label: 'Nuevos Registros',
    data: cantidades,
    backgroundColor: 'rgba(255, 230, 0, 0.2)',
    borderColor: '#FFE600',
    borderWidth: 3,
    fill: true,
    tension: 0.4,
    pointBackgroundColor: '#FFE600',
    pointBorderColor: '#2E2E38',
    pointBorderWidth: 2,
    pointRadius: 5,
    pointHoverRadius: 7
                    }]
                },
    options: {
        responsive: true,
    maintainAspectRatio: true,
    plugins: {
        legend: {
        display: true,
    position: 'top',
    labels: {
        font: {
        size: 14,
    weight: 'bold'
                                },
    color: '#2E2E38'
                            }
                        },
    tooltip: {
        backgroundColor: '#2E2E38',
    titleColor: '#FFE600',
    bodyColor: '#ffffff',
    padding: 12,
    cornerRadius: 8,
    displayColors: false
                        }
                    },
    scales: {
        y: {
        beginAtZero: true,
    ticks: {
        stepSize: 1,
    color: '#747480'
                            },
    grid: {
        color: 'rgba(0, 0, 0, 0.05)'
                            }
                        },
    x: {
        ticks: {
        color: '#747480'
                            },
    grid: {
        display: false
                            }
                        }
                    }
                }
            });
        }

    function crearGraficaEstatus(activos, inactivos) {
            const ctx = document.getElementById('chartEstatus');
    if (!ctx) return;

    // Destruir gráfica anterior si existe
    if (chartEstatus) {
        chartEstatus.destroy();
            }

    const total = activos + inactivos;
            const porcentajeActivos = total > 0 ? ((activos / total) * 100).toFixed(1) : 0;
            const porcentajeInactivos = total > 0 ? ((inactivos / total) * 100).toFixed(1) : 0;

    chartEstatus = new Chart(ctx, {
        type: 'doughnut',
    data: {
        labels: ['Activos', 'Inactivos'],
    datasets: [{
        data: [activos, inactivos],
    backgroundColor: [
    '#28a745',
    '#dc3545'
    ],
    borderColor: '#ffffff',
    borderWidth: 3
                    }]
                },
    options: {
        responsive: true,
    maintainAspectRatio: true,
    plugins: {
        legend: {
        position: 'bottom',
    labels: {
        font: {
        size: 14,
    weight: 'bold'
                                },
    padding: 15,
    color: '#2E2E38',
    generateLabels: function(chart) {
                                    const data = chart.data;
                                    return data.labels.map((label, i) => {
                                        const value = data.datasets[0].data[i];
                                        const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
    return {
        text: `${label}: ${value} (${percentage}%)`,
    fillStyle: data.datasets[0].backgroundColor[i],
    hidden: false,
    index: i
                                        };
                                    });
                                }
                            }
                        },
    tooltip: {
        backgroundColor: '#2E2E38',
    titleColor: '#FFE600',
    bodyColor: '#ffffff',
    padding: 12,
    cornerRadius: 8,
    callbacks: {
        label: function(context) {
                                    const label = context.label || '';
    const value = context.parsed;
                                    const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
    return `${label}: ${value} usuarios (${percentage}%)`;
                                }
                            }
                        }
                    }
                }
            });
        }
</script>



}