@{
    ViewData["Title"] = "Home Page";
}


<link rel="stylesheet" href="~/css/indexHome.css" asp-append-version="true" />

<!-- Carrusel automático -->
<div class="container mt-4 mb-5">
    <div id="imageCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">

        <div class="carousel-inner rounded-4 shadow">

            <div class="carousel-item active">
                <img src="https://www.ey.com/adobe/dynamicmedia/deliver/dm-aid--2a492ed9-e1be-4c38-ae83-8c9c80fbcdf2/ey-virtual-tablet.png?preferwebp=true&quality=85"
                     class="d-block w-100"
                     style="height:350px; object-fit:cover;">
            </div>

            <div class="carousel-item">
                <img src="https://www.ey.com/adobe/dynamicmedia/deliver/dm-aid--148a7a7a-9af4-4288-8e31-3876485e5490/ey-global-tax-platform-welcome-screen-laptop-1800x1200.png?quality=85&preferwebp=true"
                     class="d-block w-100"
                     style="height:350px; object-fit:cover;">
            </div>

            <div class="carousel-item">
                <img src="https://www.ey.com/adobe/dynamicmedia/deliver/dm-aid--ba685a9c-5bc3-45b7-af3d-e720fce2262e/ey-ficci-risk-survey-banner-2026.png?quality=85&preferwebp=true"
                     class="d-block w-100"
                     style="height:350px; object-fit:cover;">
            </div>

        </div>

        <!-- Flechas -->
        <button class="carousel-control-prev" type="button" data-bs-target="#imageCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#imageCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

    </div>
</div>




<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="hero-content">
                    <span class="badge-custom mb-3">
                        <i class="bi bi-star-fill"></i> Sistema Empresarial
                    </span>

                    <h1 class="display-3 fw-bold mb-4">
                        Bienvenido al <br>
                        <span class="text-ey-yellow">Sistema EY</span>
                    </h1>

                    <p class="lead text-muted mb-5">
                        Plataforma integral de gestión de usuarios y administración empresarial
                        con la calidad y respaldo de EY. Optimiza tus procesos con tecnología de vanguardia.
                    </p>

                    <!-- BOTONES ELIMINADOS -->

                    <div class="stats-row mt-5">
                        <div class="stat-item">
                            <h3 class="fw-bold mb-0">500+</h3>
                            <p class="text-muted mb-0">Empresas</p>
                        </div>
                        <div class="stat-item">
                            <h3 class="fw-bold mb-0">99.9%</h3>
                            <p class="text-muted mb-0">Uptime</p>
                        </div>
                        <div class="stat-item">
                            <h3 class="fw-bold mb-0">24/7</h3>
                            <p class="text-muted mb-0">Soporte</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-image-wrapper">
                    <div class="ey-logo-card">
                        <div class="logo-content">
                            <h2 class="display-1 fw-bold mb-3">EY</h2>
                            <p class="fs-5 fw-semibold mb-4">Building a better working world</p>
                            <div class="feature-pills">
                                <span class="pill"><i class="bi bi-shield-check"></i> Seguro</span>
                                <span class="pill"><i class="bi bi-lightning-charge"></i> Rápido</span>
                                <span class="pill"><i class="bi bi-graph-up"></i> Escalable</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Features Section -->
<div class="features-section py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge-custom mb-3">
                <i class="bi bi-gem"></i> Características
            </span>
            <h2 class="display-5 fw-bold mb-3">¿Por qué elegir nuestro sistema?</h2>
            <p class="lead text-muted">Tecnología empresarial con estándares de excelencia</p>
        </div>

        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="icon-box">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h5 class="fw-bold mt-3 mb-2">Seguridad Total</h5>
                    <p class="text-muted">Protección avanzada con encriptación de datos y autenticación multifactor.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="icon-box">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h5 class="fw-bold mt-3 mb-2">Alto Rendimiento</h5>
                    <p class="text-muted">Respuestas en tiempo real para una gestión ágil y eficiente.</p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="feature-card">
                    <div class="icon-box">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <h5 class="fw-bold mt-3 mb-2">Escalabilidad</h5>
                    <p class="text-muted">Crece sin límites junto con tu empresa sin comprometer el rendimiento.</p>
                </div>
            </div>
        </div>
    </div>
</div>
