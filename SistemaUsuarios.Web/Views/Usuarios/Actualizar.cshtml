@model CapaNegocio.DTOs.UsuarioDTO
@{
    ViewData["Title"] = "Actualizar Usuario";
}

<link rel="stylesheet" href="~/css/actualizar.css" asp-append-version="true" />

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="mb-1">
                        <i class="bi bi-pencil-square" style="color: #FFE600;"></i>
                        Actualizar Usuario
                    </h1>
                    <p class="text-muted">Modifica la información del usuario</p>
                </div>
                @if (User.Identity.IsAuthenticated)
                {
                    <a href="@Url.Action("Lista", "Usuarios")" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Volver
                    </a>
                }
            </div>

            <!-- Mensajes -->
            <div id="mensaje"></div>

            <!-- Formulario -->
            <div class="card shadow-lg border-0">
                <div class="card-header" style="background: linear-gradient(135deg, #2E2E38 0%, #1E1E1E 100%); color: #FFE600;">
                    <h5 class="mb-0">
                        <i class="bi bi-person-gear"></i> Información del Usuario
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form id="formUpdateUsuario">
                        @Html.AntiForgeryToken()
                        
                        <input type="hidden" asp-for="Id" id="userId" />

                        <!-- Nombre Completo -->
                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label fw-bold">
                                <i class="bi bi-person"></i> Nombre Completo
                                <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-person-circle"></i>
                                </span>
                                <input asp-for="NombreCompleto" class="form-control" id="txtNombre" placeholder="Nombre completo del usuario" required />
                            </div>
                            <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <!-- Nombre de Usuario -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="NombreUsuario" class="form-label fw-bold">
                                    <i class="bi bi-at"></i> Nombre de Usuario
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-person-badge"></i>
                                    </span>
                                    <input asp-for="NombreUsuario" class="form-control" id="txtUsuario" placeholder="Usuario" required />
                                </div>
                                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
                            </div>

                            <!-- Correo -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Correo" class="form-label fw-bold">
                                    <i class="bi bi-envelope"></i> Correo Electrónico
                                    <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-envelope-at"></i>
                                    </span>
                                    <input asp-for="Correo" class="form-control" type="email" id="txtCorreo" placeholder="correo@ejemplo.com" required />
                                </div>
                                <span asp-validation-for="Correo" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Contraseña -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">
                                <i class="bi bi-key"></i> Nueva Contraseña
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-lock-fill"></i>
                                </span>
                                <input asp-for="Password" class="form-control" type="password" id="txtPassword" placeholder="Dejar vacío para mantener la actual" />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="bi bi-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-info-circle"></i> Dejar vacío si no desea cambiar la contraseña
                            </small>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- Estatus -->
                        <div class="mb-4">
                            <div class="form-check form-switch" style="font-size: 1.1rem;">
                                <input class="form-check-input" type="checkbox" asp-for="Estatus" id="chkEstatus" style="cursor: pointer; width: 3rem; height: 1.5rem;">
                                    <label class="form-check-label fw-bold" for="chkEstatus" style="margin-left: 0.5rem;">
                                        <i class="bi bi-toggle-on text-success"></i> Usuario Activo
                                    </label>
                                    <br>
                                    <small class="text-muted ms-5">El usuario podrá acceder al sistema</small>
                                </div>
                            </div>

                            <!-- Botones -->
                            <hr class="my-4">
                            <div class="d-flex justify-content-end gap-3">
                                <a href="@Url.Action("Lista", "Usuarios")" class="btn btn-secondary btn-lg">
                                    <i class="bi bi-x-circle"></i> Cancelar
                                </a>
                                <button type="button" id="btnActualizar" class="btn btn-primary btn-lg">
                                    <i class="bi bi-save"></i> Guardar Cambios
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Info adicional -->
                <div class="alert alert-info mt-4 border-0" style="background-color: #e8f4f8;">
                    <i class="bi bi-info-circle-fill"></i>
                    <strong>Nota:</strong> Los campos marcados con <span class="text-danger">*</span> son obligatorios.
                </div>
            </div>
        </div>
    </div>

   

    @section Scripts {
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
    
        <script>
            // Toggle mostrar/ocultar contraseña
            document.getElementById("togglePassword")?.addEventListener("click", function () {
                const passwordInput = document.getElementById("txtPassword");
                const eyeIcon = document.getElementById("eyeIcon");
            
                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    eyeIcon.classList.remove("bi-eye");
                    eyeIcon.classList.add("bi-eye-slash");
                } else {
                    passwordInput.type = "password";
                    eyeIcon.classList.remove("bi-eye-slash");
                    eyeIcon.classList.add("bi-eye");
                }
            });

            // Cargar datos del usuario cuando se carga la página
            $(document).ready(function () {
                const urlParams = new URLSearchParams(window.location.search);
                const userId = urlParams.get('id') || '@Model?.Id';
            
                if (userId && userId !== '0') {
                    cargarDatosUsuario(userId);
                }

                // Evento del botón actualizar
                $("#btnActualizar").click(function (e) {
                    e.preventDefault();
                    actualizarUsuario();
                });
            });

            function cargarDatosUsuario(id) {
                $.ajax({
                    url: '@Url.Action("GetById", "Usuarios")',
                    type: 'GET',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            const usuario = response.data;
                            $('#userId').val(usuario.id);
                            $('#txtNombre').val(usuario.nombreCompleto);
                            $('#txtUsuario').val(usuario.nombreUsuario);
                            $('#txtCorreo').val(usuario.correo);
                            $('#chkEstatus').prop('checked', usuario.estatus);
                        } else {
                            alert('Error al cargar los datos del usuario: ' + response.message);
                        }
                    },
                    error: function (xhr) {
                        console.error('Error:', xhr.responseText);
                        alert('Error al cargar los datos del usuario');
                    }
                });
            }

            function actualizarUsuario() {
                const id = parseInt($('#userId').val());
                const token = $('input[name="__RequestVerificationToken"]').val();

                // Validación de seguridad
                if (!id || id == 0) {
                    mostrarMensaje('Error: No se pudo identificar el ID del usuario.', 'danger');
                    return;
                }

                const usuarioData = {
                    Id: id,
                    NombreCompleto: $('#txtNombre').val().trim(),
                    NombreUsuario: $('#txtUsuario').val().trim(),
                    Correo: $('#txtCorreo').val().trim(),
                    Password: $('#txtPassword').val(),
                    Estatus: $('#chkEstatus').is(':checked')
                };

                // Validaciones básicas
                if (!usuarioData.NombreCompleto || !usuarioData.NombreUsuario || !usuarioData.Correo) {
                    mostrarMensaje('Por favor, completa todos los campos obligatorios.', 'danger');
                    return;
                }

                const $btn = $('#btnActualizar');
                const originalText = $btn.html();
                $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i> Actualizando...');

                // Llamada AJAX
                $.ajax({
                    url: '@Url.Action("Update", "Usuarios")',
                    type: "POST",
                    contentType: "application/json",
                    headers: {
                        "RequestVerificationToken": token
                    },
                    data: JSON.stringify(usuarioData),
                    success: function (response) {
                        if (response.success) {
                            mostrarMensaje(response.message, 'success');
                            setTimeout(function() {
                                window.location.href = '@Url.Action("Lista", "Usuarios")';
                            }, 1500);
                        } else {
                            mostrarMensaje('Error: ' + response.message, 'danger');
                            $btn.prop('disabled', false).html(originalText);
                        }
                    },
                    error: function (xhr) {
                        console.error('Error:', xhr.responseText);
                        mostrarMensaje('Ocurrió un error crítico en el servidor.', 'danger');
                        $btn.prop('disabled', false).html(originalText);
                    }
                });
            }

            function mostrarMensaje(texto, tipo) {
                const claseAlerta = tipo === 'success' ? 'alert-success-custom' : 'alert-danger-custom';
                const icono = tipo === 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill';
            
                const html = `
                    <div class="${claseAlerta} alert alert-dismissible fade show" role="alert">
                        <i class="bi ${icono}"></i>
                        <strong>${tipo === 'success' ? '¡Éxito!' : 'Error:'}</strong> ${texto}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                `;
            
                $('#mensaje').html(html);
                $('#mensaje')[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        </script>
    }