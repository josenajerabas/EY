@model CapaNegocio.DTOs.LoginDTO
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - EY Sistema</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/loginAuth.css" asp-append-version="true" />
 
</head>
<body>
    <div class="login-container">
        <div class="logo-section">
            <h1><span class="ey-brand">EY</span></h1>
            <p>Building a better working world</p>
        </div>

        <h2>
            <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
        </h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-success">
                <i class="bi bi-check-circle-fill"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="validation-summary-errors">
                <ul>
                    <li>@TempData["ErrorMessage"]</li>
                </ul>
            </div>
        }

        <form asp-controller="Auth" asp-action="Login" method="post" id="loginForm">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

            <div class="form-group">
                <label asp-for="NombreUsuario">
                    <i class="bi bi-person"></i> Nombre de Usuario
                </label>
                <div class="input-wrapper">
                    <i class="bi bi-person-circle"></i>
                    <input type="text" 
                           asp-for="NombreUsuario" 
                           class="form-control" 
                           placeholder="Ingresa tu usuario" 
                           autocomplete="username"
                           required>
                </div>
                <span asp-validation-for="NombreUsuario" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">
                    <i class="bi bi-lock"></i> Contraseña
                </label>
                <div class="input-wrapper">
                    <i class="bi bi-key-fill"></i>
                    <input type="password" 
                           asp-for="Password" 
                           class="form-control" 
                           placeholder="••••••••" 
                           autocomplete="current-password"
                           required>
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-login" id="btnLogin">
                <i class="bi bi-box-arrow-in-right"></i> Iniciar Sesión
            </button>
        </form>

        <div class="footer">
            <p>¿No tienes cuenta? <a asp-controller="Usuarios" asp-action="Registrar">Regístrate aquí</a></p>
            <div class="back-home">
                <a asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Volver al inicio
                </a>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    
    <script src="~/js/auth/login.js" asp-append-version="true"></script>

</body>
</html>